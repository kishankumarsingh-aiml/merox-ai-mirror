# ==============================================================================
# MeroX Smart Mirror Retail Platform — Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' for local deployment or configure in hosting provider.
# 2. NEVER commit production secrets, private keys, or credentials to version control.
# 3. Rotate any API key that has been exposed in public repositories.
# ==============================================================================

# Node Environment ('development' | 'staging' | 'production')
NODE_ENV=production

# Server & Network Configuration
PORT=5500
HOST=0.0.0.0
CORS_ALLOWED_ORIGINS=https://mirror.merox.ai,https://admin.merox.ai

# Physical Smart Mirror Kiosk Hardware Identity
STORE_ID=STORE-MUM-01
STORE_NAME=MeroX Flagship Kiosk — Mumbai Phoenix Mall
MIRROR_ID=MIRROR-MUM-01-FL02
KIOSK_DEFAULT_MODE=true
KIOSK_INACTIVITY_TIMEOUT_SEC=90
KIOSK_WARNING_COUNTDOWN_SEC=15

# Backend API Gateway (for production database & server-side AI proxy)
# In development, leave blank to use client-side catalog and offline expert AI engine
MEROX_BACKEND_API_URL=https://api.merox.ai/v1

# Generative AI Provider (Server-Side Proxy Only — NEVER expose in frontend code)
GEMINI_API_KEY=your_gemini_api_key_for_backend_proxy_only
GEMINI_MODEL=gemini-1.5-flash

# Firebase Web Client Configuration (Public Web SDK client identifiers)
# CRITICAL: In GCP Console, restrict this apiKey by HTTP referrer to your authorized domains!
FIREBASE_API_KEY=your_firebase_client_web_api_key
FIREBASE_AUTH_DOMAIN=merox-ai-mirror.firebaseapp.com
FIREBASE_PROJECT_ID=merox-ai-mirror
FIREBASE_STORAGE_BUCKET=merox-ai-mirror.appspot.com
FIREBASE_MESSAGING_SENDER_ID=69028024588
FIREBASE_APP_ID=1:69028024588:web:f374b0e927adfe839ff929

# Firebase Admin Service Account (Backend Server Only — Path to JSON secret)
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=/etc/merox/secrets/firebase-service-account.json
